# Local development must leave outbound delivery disabled.
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
EMAIL_DELIVERY_ENABLED=false
RESCHEDULE_NOTIFICATIONS_ENABLED=false
# For an explicitly approved local browser test only, set this to the sole
# authorized test customer's database email. Other recipients are not sent.
# EMAIL_LOCAL_TEST_RECIPIENT=
# QR remains off until Eli's migration and public verifier privacy review are complete.
EMAIL_TICKET_QR_ENABLED=false
EMAIL_TICKET_QR_PRIVACY_APPROVED=false

# Required for login and protected API requests. Supply a random secret of at
# least 32 bytes in the local ignored .env or deployment secret manager.
# Never reuse SMTP_PASS or commit a real secret here.
AUTH_TOKEN_SECRET=
# Public HTTPS origin only, for example https://tickets.example.com (no path).
PUBLIC_APP_ORIGIN=
# Only the manually invoked smoke-test script reads this allowlist.
EMAIL_SMOKE_TEST_RECIPIENTS=

# Configure only on the backend when a trusted mail account is approved.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
# Optional local development workaround for SMTP hostname connection timeouts.
# Resolve the hostname to IPv4 while retaining it for TLS certificate checks.
SMTP_LOCAL_IPV4_RESOLVE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=FilmVault <no-reply@example.invalid>
